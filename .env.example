# Copy to .env and fill in. Do not commit .env.
# See README.md and AUTH_SETUP.md for other required variables (e.g. DATABASE_URL, NEXTAUTH_*).

# -----------------------------------------------------------------------------
# Sentry (error monitoring)
# -----------------------------------------------------------------------------
# DSN from Sentry project settings. If missing, Sentry no-ops (local dev is safe).
SENTRY_DSN=
# Required for client-side reporting (browser). Can be same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Environment label in Sentry (e.g. development | production).
SENTRY_ENVIRONMENT=development

# Performance tracing: 0 = off, 1 = 100%. Keep low in production (e.g. 0.1).
SENTRY_TRACES_SAMPLE_RATE=0

# Profiling sample rate. 0 = off.
SENTRY_PROFILES_SAMPLE_RATE=0

# Optional: release identifier (e.g. git commit SHA). Helps match errors to deploys.
# SENTRY_RELEASE=

# Optional: for source map upload (Vercel/CI). Do not commit auth token.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Required for sending email. Get from Resend dashboard.
RESEND_API_KEY=
# Must be support@nooc.io (or "[REDACTED]").
EMAIL_FROM=support@nooc.io
# Set to true only if you explicitly want the send endpoint available in production.
# ENABLE_EMAIL_SEND_IN_PRODUCTION=false
# Required in production to authorize POST /api/email/dispatch (header: x-dispatch-secret).
DISPATCH_SECRET=
# Used by Vercel Cron to authenticate GET requests to /api/email/dispatch and /api/cron/booking-end-reminders; set in Vercel to the same value as DISPATCH_SECRET (or any secret only Vercel cron knows).
CRON_SECRET=

# -----------------------------------------------------------------------------
# Demo page (/demo)
# -----------------------------------------------------------------------------
# Optional override for the demo video (HTTPS MP4 recommended).
# /demo fetches it via GET /api/demo-video-url.
# Default (no env needed): /demo-video.mp4 from public/
# Do NOT use .mov / QuickTime URLs — the app ignores them.
# DEMO_VIDEO_URL=
# NEXT_PUBLIC_DEMO_VIDEO_URL=

# -----------------------------------------------------------------------------
# Mobile / Capacitor (App Store + Play Store)
# See docs/mobile/phase-0-prerequisites.md
# -----------------------------------------------------------------------------
# Sign in with Apple (App Store Guideline 4.8 when Google is offered)
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Pre-built client secret JWT (generate via: npm run apple:secret)
APPLE_SECRET=

# APNs (iOS push)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=io.nooc.app
APNS_PRIVATE_KEY=
APNS_PRODUCTION=true

# FCM HTTP v1 (Android push)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Optional: URL the Capacitor shell loads (defaults to production)
# NEXT_PUBLIC_MOBILE_APP_URL=https://nooc.io
